# Cross-platform text normalisation
* text=auto

*.json text eol=lf
*.dart text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.xlsx binary
*.zip binary
*.keystore binary
*.jks binary
